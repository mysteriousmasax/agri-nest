{
  "name": "agri-nest",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "node tools/dev-server.js",
    "start:static": "npx http-server www -p 8080 -c-1 --cors",
    "web:build": "node tools/build-web.js",
    "web:serve": "npm run web:build && node tools/dev-server.js",
    "web": "npm run web:serve",
    "react:dev": "vite",
    "react:build": "vite build",
    "react:preview": "vite preview",
    "electron:dev": "npm run react:build && electron .",
    "electron:build": "npm run react:build && electron-builder",
    "mock-api": "node api/mock_server.js",
    "api:start": "node api/server.js",
    "api:test": "node api/test-endpoints.js",
    "migrate": "node ./db/run_migrations.js",
    "build:web": "node tools/build-web.js",
    "build:web:py": "powershell -ExecutionPolicy Bypass -File tools/build-web-ps.ps1",
    "prepare": "npm run build:web",
    "cap:init": "npx cap init agri-nest com.agri.nest --web-dir=www",
    "verify": "node tools/verify-app.js",
    "check:routes": "node tools/health-check.js http://localhost:8080",
    "test:integration": "mocha --timeout 20000 tests/integration/**/*.js",
    "test": "npm run test:integration"
  },
  "build": {
    "appId": "com.agri.nest",
    "productName": "AGRI-NEST",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "ajv-formats": "^2.1.1",
    "body-parser": "^1.20.2",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-openapi-validator": "^5.6.2",
    "knex": "^2.4.2",
    "nodemailer": "^6.9.4",
    "twilio": "^4.11.0",
    "pg": "^8.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "chai": "^4.3.8",
    "electron": "^26.2.0",
    "electron-builder": "^24.6.0",
    "fs-extra": "^11.1.1",
    "http-server": "^14.1.1",
    "mocha": "^10.2.0",
    "supertest": "^6.3.3",
    "vite": "^5.4.2"
  }
}
